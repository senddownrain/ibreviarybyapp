<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- The system owns the only launch icon on Android 12 and later. -->
        <item name="android:windowBackground">@color/brand_launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/brand_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
