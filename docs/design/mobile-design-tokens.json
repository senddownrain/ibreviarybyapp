          "height": 1.43,
          "weight": 500
        },
        "tab": {
          "size": 12,
          "height": 1.33,
          "weight": 500
        }
      }
    },
    "scaling": {
      "default": 1,
      "min": 0.85,
      "max": 1.6,
      "step": 0.05,
      "system": "TextScaler.scale(baseSize * readerMultiplier); exactly once",
      "responsiveThresholdAt16": 1.3
    },
    "readerSpacingEm": {
      "paragraph": 0.65,
      "strophe": 0.85,
      "section": 1.55,
      "headerAfter": 0.55,
      "antiphonBefore": 0.8,
      "antiphonAfter": 0.9,
      "psalmHangingIndent": 0.85
    }
  },
  "surfaces": {
    "page": {
      "color": "page",
      "opacity": 1,
      "shadowLevel": 0
    },
    "reader": {
      "color": "reader",
      "opacity": 1,
      "radius": 0,
      "shadowLevel": 0,
      "blurSigma": 0
    },
    "standard": {
      "color": "standard",
      "opacity": 1,
      "radius": 16,
      "shadowLevel": 0
    },
    "elevated": {
      "color": "elevated",
      "opacity": 1,
      "radius": 20,
      "shadowLevel": 1
    },
    "floating": {
      "ios": "glassRegular",
      "android": "floating",
      "radius": "control-specific"
    },
    "glass": {
      "platform": "ios only",
      "native": "system regular material",
      "fallbackSigma": 24,
      "fallbackLightOpacity": 0.82,
      "fallbackDarkOpacity": 0.86,
      "reduceTransparencyOpacity": 1,
      "reduceTransparencySigma": 0
    },
    "modal": {
      "iosColor": "standard",
      "androidColor": "elevated",
      "opacity": 1,
      "radiusFallback": 28,
      "shadowLevel": 3,
      "scrimLightOpacity": 0.32,
      "scrimDarkOpacity": 0.48
    }
  },
  "elevation": {
    "androidDp": {
      "content": 0,
      "scrolledBar": 0,
      "floatingControls": 3,
      "menu": 3,
      "modal": 6
    },
    "customShadows": {
      "level0": [],
      "level1": [
        {
          "x": 0,
          "y": 2,
          "blur": 8,
          "spread": -2,
          "lightOpacity": 0.08,
          "darkOpacity": 0.16
        }
      ],
      "level2": [
        {
          "x": 0,
          "y": 4,
          "blur": 16,
          "spread": -4,
          "lightOpacity": 0.12,
          "darkOpacity": 0.22
        }
      ],
      "level3": [
        {
          "x": 0,
          "y": 8,
          "blur": 24,
          "spread": -6,
          "lightOpacity": 0.16,
          "darkOpacity": 0.28
        }
      ]
    },
    "rule": "native shadow OR custom shadow, never both"
  },
  "opacity": {
    "text": 1,
    "secondaryText": 1,
    "separatorLight": 0.12,
    "separatorDark": 0.16,
    "disabledDecorative": 0.38,
    "androidPressed": 0.1,
    "iosPressed": 0.08,
    "focusOverlay": 0.1
  },
  "motion": {
    "press": 90,
    "release": 140,
    "disclosure": 180,
    "contextChange": 200,
    "chrome": 180,
    "sheetFallback": 280,
    "reduceMotion": 0,
    "easingEnter": "easeOutCubic",
    "easingExit": "easeInCubic",
    "fontResize": 0,
    "readerTextTransition": 0,
    "decorativeLoop": false
  },
  "readerChrome": {
    "collapseForwardDistance": 64,
    "revealBackwardDistance": 24,
    "topRevealDistance": 16,
    "minimumViewportHeightForAutoCollapse": 480,
    "autoCollapseLiturgicalDock": true,
    "focusManual": true,
    "revealTarget": 48
  },
  "controls": {
    "topBarIOSMin": 56,
    "topBarAndroidMin": 64,
    "bottomBarIOSFallbackMin": 64,
    "bottomBarAndroidMin": 64,
    "liturgicalDock": {"centerItemWidthMin": 56, "centerInset": 4, "sideTarget": 48, "groupGap": 8, "centerRadius": 32, "minWidth": 290, "safeAreaGap": 8},
    "dayNavigatorMin": 48,
    "hourRowMin": 64,
    "actionMin": 48,
    "modalContentPadding": 24,
    "modalMaxHeightFraction": 0.9
  },
  "accessibility": {
    "textContrastMin": 4.5,
    "readerBodyContrastGoal": 7,
    "controlContrastMin": 3,
    "focusStroke": 2,
    "focusGap": 2,
    "boldText": "raise 400 to 500, 500 to 600; max 700",
    "highContrast": "opaque surfaces; ink for metadata and semantic-color labels; keep labels and markers"
  },
  "policies": {
    "designDirection": "ambient",
    "ambientTonalHierarchyRequired": true,
    "ambientVisibleEffectRequired": true,
    "floatingDockBothPlatforms": true,
    "primarySectionNavigation": "labeled top SectionSwitcher",
    "liturgicalNavigation": "previousDay, explorer, today, calendar, nextDay",
    "seasonalWashDefault": false,
    "dynamicColorDefault": false,
    "liturgicalColorsAffectPrimary": false,
    "glassOverReaderText": false,
    "offlineIsError": false,
    "runtimeFontDownload": false,
    "keepScreenOnOnlyWhileReaderForeground": true
  }
